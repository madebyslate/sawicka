---
import type { Media } from '@payload-types';
import Container from '../../ui/Container/Container.astro';
import Section from '../../ui/Section/Section.astro';
import SectionLabel from '../../ui/SectionLabel/SectionLabel.astro';
import Heading from '../../ui/Heading/Heading.astro';
import StepItem from './StepItem.astro';
import { resolveMediaUrl } from '../../../lib/payload/media';

interface Step {
  step: string;
  title: string;
  description: string;
}

interface Props {
  tagline?: string | null;
  heading: string;
  description?: string | null;
  image?: number | Media | null;
  steps?: Step[] | null;
}

const { tagline, heading, description, image, steps } = Astro.props;

const imageUrl = resolveMediaUrl(image);
const imageAlt = image && typeof image === 'object' ? image.alt : '';
---

<Section id="how-we-work" class="bg-navy pt-25 pb-30">
  <Container>
    <div class="flex w-full flex-col items-start gap-20">
      <div
        data-reveal
        style="--reveal-delay: 0ms"
        class="flex w-full flex-col items-start gap-4 lg:flex-row lg:items-center lg:justify-between lg:gap-4 lg:self-stretch"
      >
        <div class="flex flex-col items-start gap-4 lg:max-w-2xl">
          {tagline && <SectionLabel tone="light" class="pt-3.5">{tagline}</SectionLabel>}
          <Heading as="h2" class="text-white">
            {heading}
          </Heading>
        </div>
        {description && <p class="max-w-107.25 text-body text-white/80">{description}</p>}
      </div>

      <div class="flex w-full flex-col items-start gap-8 lg:flex-row lg:items-start lg:justify-between lg:gap-4">
        {imageUrl && (
          <img
            src={imageUrl}
            alt={imageAlt}
            loading="lazy"
            class="h-114.5 w-full rounded-card object-cover lg:w-135.25 lg:shrink-0"
          />
        )}
        <div class="flex w-full flex-col items-start lg:w-163">
          {(steps ?? []).map((item, index) => (
            <StepItem step={item.step} title={item.title} revealDelay={index * 100}>
              {item.description}
            </StepItem>
          ))}
        </div>
      </div>
    </div>
  </Container>
</Section>
