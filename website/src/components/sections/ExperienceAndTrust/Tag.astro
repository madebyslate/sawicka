---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center justify-center rounded-pill border-[1.5px] border-white bg-card px-2.5 pt-0.5 pb-0.75 text-body tracking-tagline text-navy whitespace-nowrap',
    className,
  ]}
>
  <slot />
</span>
