---
import type { Media } from '@payload-types';
import Container from '../../ui/Container/Container.astro';
import Section from '../../ui/Section/Section.astro';
import SectionLabel from '../../ui/SectionLabel/SectionLabel.astro';
import Heading from '../../ui/Heading/Heading.astro';
import Icon from '../../ui/Icon/Icon.astro';
import Tag from './Tag.astro';
import { resolveMediaUrl } from '../../../lib/payload/media';

interface FactTag {
  value: string;
}

interface FactImage {
  image: number | Media;
}

interface Fact {
  label: string;
  type?: 'tags' | 'images' | null;
  tags?: FactTag[] | null;
  images?: FactImage[] | null;
}

interface Props {
  tagline?: string | null;
  heading: string;
  portrait?: number | Media | null;
  bio?: string | null;
  facts?: Fact[] | null;
  quote?: string | null;
}

const { tagline, heading, portrait, bio, facts, quote } = Astro.props;

const portraitUrl = resolveMediaUrl(portrait);
const portraitAlt = portrait && typeof portrait === 'object' ? portrait.alt : '';
---

<Section class="bg-cream">
  <Container>
    <div class="flex w-full flex-col items-start gap-20">
      <div
        data-reveal
        style="--reveal-delay: 0ms"
        class="flex w-full flex-col items-start gap-4 lg:flex-row lg:items-start lg:justify-between lg:gap-4 lg:self-stretch"
      >
        {tagline && <SectionLabel class="shrink-0 pt-3.5">{tagline}</SectionLabel>}
        <Heading as="h2" class="max-w-163.25">
          {heading}
        </Heading>
      </div>

      <div class="flex w-full flex-col items-start gap-8.75">
        <div
          data-reveal
          style="--reveal-delay: 150ms"
          class="flex w-full flex-col items-start gap-8 lg:flex-row lg:items-stretch lg:justify-between lg:gap-4 lg:self-stretch"
        >
          {portraitUrl && (
            <img
              src={portraitUrl}
              alt={portraitAlt}
              loading="lazy"
              class="h-134.5 w-full rounded-card object-cover lg:w-135.25 lg:shrink-0"
            />
          )}

          <div class="flex w-full flex-col items-start gap-30 lg:w-163 lg:justify-between">
            <div class="flex flex-col items-start gap-19.5 lg:flex-row lg:items-start">
              <img src="/icons/infinity.svg" alt="" width="32" height="17" loading="lazy" class="shrink-0" />
              {bio && <p class="max-w-135.5 text-body text-navy/80">{bio}</p>}
            </div>

            {facts && facts.length > 0 && (
              <div class="flex w-full flex-col items-start gap-4">
                {facts.map((fact) => (
                  <div class="flex w-full items-start justify-between gap-4 border-b border-navy/60 pb-4">
                    <p class="font-serif text-body text-navy">{fact.label}</p>
                    {fact.type === 'images' ? (
                      <div class="flex max-w-88 items-center gap-6">
                        {(fact.images ?? []).map((item) => {
                          const imageUrl = resolveMediaUrl(item.image);
                          const imageAlt = typeof item.image === 'object' ? item.image.alt : '';
                          return imageUrl && <img src={imageUrl} alt={imageAlt} loading="lazy" class="h-15 w-auto" />;
                        })}
                      </div>
                    ) : (
                      <div class="flex max-w-88 flex-wrap justify-end gap-1.5">
                        {(fact.tags ?? []).map((tag) => <Tag>{tag.value}</Tag>)}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>

        {quote && (
          <div data-reveal style="--reveal-delay: 300ms" class="flex items-start gap-4 lg:w-135.25">
            <Icon src="/icons/quote.svg" alt="" size={40} class="-mt-2.25 shrink-0" />
            <p class="text-body text-navy">{quote}</p>
          </div>
        )}
      </div>
    </div>
  </Container>
</Section>
