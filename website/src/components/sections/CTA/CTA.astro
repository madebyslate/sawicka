---
import type { Media } from '@payload-types';
import Container from '../../ui/Container/Container.astro';
import SectionLabel from '../../ui/SectionLabel/SectionLabel.astro';
import Heading from '../../ui/Heading/Heading.astro';
import Button from '../../ui/Button/Button.astro';
import { resolveLinkHref, type LinkLike } from '../../../lib/payload/link';
import { resolveMediaUrl } from '../../../lib/payload/media';
import { getGlobalCta } from '../../../lib/payload/global-cta';

interface Props {
  useGlobal?: boolean | null;
  eyebrow?: string | null;
  heading?: string | null;
  description?: string | null;
  backgroundImage?: number | Media | null;
  button?: LinkLike | null;
}

const props = Astro.props;

const { eyebrow, heading, description, backgroundImage, button } =
  props.useGlobal ?? true ? await getGlobalCta() : props;

const backgroundImageUrl = resolveMediaUrl(backgroundImage);
const backgroundImageAlt = backgroundImage && typeof backgroundImage === 'object' ? backgroundImage.alt : '';
const buttonHref = resolveLinkHref(button);
---

<section id="kontakt" class="relative isolate overflow-hidden">
  {
    backgroundImageUrl && (
      <img
        src={backgroundImageUrl}
        alt={backgroundImageAlt}
        loading="lazy"
        class="absolute inset-0 -z-20 h-full w-full object-cover"
      />
    )
  }
  <div class="absolute inset-0 -z-10 bg-scrim/24"></div>
  <div class="absolute inset-0 -z-10 bg-linear-to-r from-scrim/80 from-[21.875%] to-scrim/0 to-[70.556%]"></div>

  <Container class="flex min-h-180 py-15">
    <div class="flex w-full max-w-lg flex-col justify-between gap-16 text-white">
      <div data-reveal style="--reveal-delay: 0ms" class="flex flex-col gap-4">
        {eyebrow && (
          <SectionLabel tone="light">
            {eyebrow}
          </SectionLabel>
        )}
        <Heading as="h2" class="font-normal">
          {heading}
        </Heading>
      </div>
      <div data-reveal style="--reveal-delay: 150ms" class="flex flex-col gap-8">
        {description && <p class="text-body text-white/80">{description}</p>}
        <Button variant="primary" href={buttonHref} class="self-start">
          {button?.label}
        </Button>
      </div>
    </div>
  </Container>
</section>
