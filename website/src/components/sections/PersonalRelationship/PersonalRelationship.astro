---
import type { Media } from '@payload-types';
import Container from '../../ui/Container/Container.astro';
import Section from '../../ui/Section/Section.astro';
import SectionLabel from '../../ui/SectionLabel/SectionLabel.astro';
import Heading from '../../ui/Heading/Heading.astro';
import IconFeatureCard from '../../ui/IconFeatureCard/IconFeatureCard.astro';
import { resolveMediaUrl } from '../../../lib/payload/media';

interface Feature {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  tagline?: string | null;
  heading: string;
  description?: string | null;
  image?: number | Media | null;
  features?: Feature[] | null;
}

const { tagline, heading, description, image, features } = Astro.props;

const imageUrl = resolveMediaUrl(image);
const imageAlt = image && typeof image === 'object' ? image.alt : '';
const imageWidth = image && typeof image === 'object' ? (image.width ?? undefined) : undefined;
const imageHeight = image && typeof image === 'object' ? (image.height ?? undefined) : undefined;

const leftColumn = (features ?? []).filter((_, index) => index % 2 === 0);
const rightColumn = (features ?? []).filter((_, index) => index % 2 === 1);
---

<Section id="o-mnie" class="bg-cream">
  <Container>
    <div class="flex w-full flex-col items-start gap-20">
      <div data-reveal style="--reveal-delay: 0ms" class="flex w-full flex-col items-start gap-4">
        {tagline && <SectionLabel>{tagline}</SectionLabel>}
        <div class="flex w-full flex-col items-start gap-4 lg:flex-row lg:items-center lg:justify-between">
          <Heading as="h2" class="max-w-163.25">
            {heading}
          </Heading>
          {description && <p class="max-w-106.25 text-body text-navy/80">{description}</p>}
        </div>
      </div>

      <div
        data-reveal
        style="--reveal-delay: 150ms"
        class="grid w-full grid-cols-1 gap-4 lg:grid-cols-[minmax(0,429px)_minmax(0,429px)_minmax(0,429px)]"
      >
        <div class="flex flex-col gap-4">
          {leftColumn.map((item) => (
            <IconFeatureCard icon={item.icon} title={item.title}>
              {item.description}
            </IconFeatureCard>
          ))}
        </div>
        <div class="flex flex-col gap-4">
          {rightColumn.map((item) => (
            <IconFeatureCard icon={item.icon} title={item.title}>
              {item.description}
            </IconFeatureCard>
          ))}
        </div>
        {imageUrl && (
          <img
            src={imageUrl}
            alt={imageAlt}
            width={imageWidth}
            height={imageHeight}
            loading="lazy"
            class="h-full min-h-80 w-full rounded-card object-cover"
          />
        )}
      </div>
    </div>
  </Container>
</Section>
