---
import Container from '../../ui/Container/Container.astro';
import Image from '../../ui/Image/Image.astro';
import Button from '../../ui/Button/Button.astro';
import defaultLogo from '../../../assets/footer/logo.png';
import { getHeader } from '../../../lib/payload/header';
import { getMenuItems } from '../../../lib/payload/menu';
import { resolveLinkHref } from '../../../lib/payload/link';
import { resolveMediaUrl } from '../../../lib/payload/media';

const header = await getHeader();
const navLinks = getMenuItems(header.mainMenu);
const ctaHref = resolveLinkHref(header.cta);
const logoUrl = resolveMediaUrl(header.logo);
const logoAlt = header.logo && typeof header.logo === 'object' ? header.logo.alt : 'Sawicka Grzyb';
const logoHref = header.logoLink || '/';
---

<header class="absolute inset-x-0 top-0 z-20 has-[details[open]]:fixed has-[details[open]]:bg-navy">
  <Container>
    <div class="flex items-center justify-between py-6 lg:grid lg:grid-cols-[1fr_auto_1fr]">
      <a href={logoHref} class="h-13 w-24 shrink-0">
        {
          logoUrl ? (
            <img src={logoUrl} alt={logoAlt} loading="eager" class="h-13 w-24 object-contain" />
          ) : (
            <Image src={defaultLogo} alt={logoAlt} width={96} height={52} loading="eager" class="h-13 w-24 object-contain" />
          )
        }
      </a>

      <nav class="hidden items-center gap-12 lg:flex">
        {
          navLinks.map((link) => (
            <a href={resolveLinkHref(link)} class="nav-link text-body leading-[1.2] tracking-tagline text-white">
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-4 lg:justify-self-end">
        <div class="hidden lg:block">
          <Button variant="primary" size="sm" href={ctaHref}>
            {header.cta?.label}
          </Button>
        </div>

        <details class="group ml-auto lg:hidden">
          <summary
            class="flex size-12 cursor-pointer list-none items-center justify-center rounded-full border border-white text-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white [&::-webkit-details-marker]:hidden"
          >
            <span class="sr-only">Menu</span>
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
              class="block group-open:hidden"
            >
              <path d="M3 6h14M3 10h14M3 14h14" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
              class="hidden group-open:block"
            >
              <path d="M5 5l10 10M15 5L5 15" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </summary>

          <nav
            data-mobile-nav
            class="fixed inset-x-0 top-25 bottom-0 z-20 flex flex-col overflow-y-auto bg-navy px-4 pb-8"
          >
            <ul class="flex flex-col border-t border-white/15">
              {
                navLinks.map((link) => (
                  <li class="border-b border-white/15">
                    <a
                      href={resolveLinkHref(link)}
                      class="flex items-center justify-between py-6 text-[20px] font-medium text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                    >
                      <span>{link.label}</span>
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path
                          d="M6 3l5 5-5 5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </li>
                ))
              }
            </ul>

            <Button variant="primary" size="sm" href={ctaHref} class="mt-auto w-full justify-center">
              {header.cta?.label}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path
                  d="M6 3l5 5-5 5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </Button>
          </nav>
        </details>
      </div>
    </div>
  </Container>
</header>

<script>
  document.querySelectorAll('[data-mobile-nav] a').forEach((link) => {
    link.addEventListener('click', () => {
      link.closest('details')?.removeAttribute('open');
    });
  });
</script>
