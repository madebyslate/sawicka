---
interface Props {
  value: string;
  suffix?: string | null;
  label: string;
  class?: string;
}

const { value, suffix, label, class: className } = Astro.props;
---

<div class:list={['flex w-fit max-w-50 flex-col items-start gap-4', className]}>
  <div class="flex items-center">
    <p class="font-serif text-[44px] leading-[1.2] tracking-[-1.76px] text-bronze italic sm:text-[64px] sm:tracking-[-2.56px] lg:text-[82px] lg:leading-[98.4px] lg:tracking-[-3.28px]">
      {value}
      {suffix && <span class="text-[20px] sm:text-[28px] lg:text-[36px]">{suffix}</span>}
    </p>
    <div class="h-10 w-0 shrink-0 bg-navy/10 lg:h-20" />
  </div>
  <dt class="sr-only">Statystyka</dt>
  <dd class="text-[16px] leading-normal text-navy">
    {label}
  </dd>
</div>
