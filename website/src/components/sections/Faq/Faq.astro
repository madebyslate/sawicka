---
import type { LinkLike } from '../../../lib/payload/link';
import Container from '../../ui/Container/Container.astro';
import Section from '../../ui/Section/Section.astro';
import SectionLabel from '../../ui/SectionLabel/SectionLabel.astro';
import Heading from '../../ui/Heading/Heading.astro';
import Button from '../../ui/Button/Button.astro';
import AccordionItem from '../../ui/AccordionItem/AccordionItem.astro';
import { resolveLinkHref } from '../../../lib/payload/link';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  tagline?: string | null;
  heading: string;
  description?: string | null;
  button?: LinkLike | null;
  faqs?: FaqItem[] | null;
}

const { tagline, heading, description, button, faqs } = Astro.props;

const defaultFaqs: FaqItem[] = [
  {
    question: 'How much do your accounting services cost?',
    answer:
      "Every business is different, so pricing depends on the services you need, the size of your business, and the complexity of your accounting. After a free consultation, you'll receive a clear, transparent quote with no hidden fees.",
  },
  {
    question: 'Can you help me switch from my current accountant?',
    answer:
      "Yes. I'll handle the transfer process and coordinate with your previous accountant whenever possible, making the transition as simple and stress-free as possible.",
  },
  {
    question: 'Do we need to meet in person?',
    answer:
      'Not at all. I work with clients both remotely and in person, depending on your preference. Most day-to-day communication can be handled efficiently by phone or email.',
  },
  {
    question: 'What accounting software do you use?',
    answer:
      "I work with trusted accounting platforms and can adapt to the software that best fits your business needs. During our consultation, we'll determine the most suitable solution together.",
  },
  {
    question: 'Will I always work directly with you?',
    answer:
      "Yes. As an independent accountant, I'm your direct point of contact from our first conversation through ongoing support. You'll always know who's managing your business.",
  },
  {
    question: "What happens if you're unavailable or on vacation?",
    answer:
      'Every client is informed in advance of planned leave, and important deadlines are carefully scheduled to ensure your accounting continues without disruption. Your business remains fully supported at all times.',
  },
];

const items = faqs && faqs.length > 0 ? faqs : defaultFaqs;
const buttonHref = button ? resolveLinkHref(button) : '#';
const showButton = button?.label && buttonHref !== '#';
---

<Section class="bg-cream">
  <Container>
    <div class="flex w-full flex-col gap-16 lg:flex-row lg:items-stretch lg:gap-[127px] lg:justify-between">
      <div class="flex w-full flex-col justify-between gap-8 lg:w-[541px]">
        <div class="flex flex-col gap-4">
          {tagline && <SectionLabel>{tagline}</SectionLabel>}
          <Heading as="h2">{heading}</Heading>
        </div>
        <div class="flex flex-col gap-6 border-t border-[rgba(3,15,34,0.08)] pt-8">
          {description && <p class="text-body text-navy/80">{description}</p>}
          {showButton && (
            <Button variant="accent" href={buttonHref} class="self-start">
              {button.label}
            </Button>
          )}
        </div>
      </div>

      <div class="w-full lg:max-w-2xl">
        {items.map((faq) => (
          <AccordionItem question={faq.question} open={false}>
            {faq.answer}
          </AccordionItem>
        ))}
      </div>
    </div>
  </Container>
</Section>
