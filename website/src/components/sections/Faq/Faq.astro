---
import type { LinkLike } from '../../../lib/payload/link';
import Container from '../../ui/Container/Container.astro';
import Section from '../../ui/Section/Section.astro';
import SectionLabel from '../../ui/SectionLabel/SectionLabel.astro';
import Heading from '../../ui/Heading/Heading.astro';
import Button from '../../ui/Button/Button.astro';
import AccordionItem from '../../ui/AccordionItem/AccordionItem.astro';
import { resolveLinkHref } from '../../../lib/payload/link';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  tagline?: string | null;
  heading: string;
  description?: string | null;
  button?: LinkLike | null;
  faqs?: FaqItem[] | null;
}

const { tagline, heading, description, button, faqs } = Astro.props;

const defaultFaqs: FaqItem[] = [
  {
    question: 'Ile kosztują usługi księgowe?',
    answer:
      'Każda firma jest inna, więc cena zależy od potrzebnych usług, wielkości firmy i złożoności księgowości. Po bezpłatnej konsultacji otrzymasz jasną, przejrzystą wycenę bez ukrytych opłat.',
  },
  {
    question: 'Czy pomożecie mi zmienić obecną księgową?',
    answer:
      'Tak. Zajmę się procesem przekazania i skoordynuję go z poprzednią księgową, gdy tylko to możliwe, dzięki czemu przejście będzie proste i bezstresowe.',
  },
  {
    question: 'Czy musimy się spotkać osobiście?',
    answer:
      'Wcale nie. Pracuję z klientami zarówno zdalnie, jak i osobiście, w zależności od preferencji. Większość bieżącej komunikacji można sprawnie prowadzić telefonicznie lub mailowo.',
  },
  {
    question: 'Z jakiego oprogramowania księgowego korzystacie?',
    answer:
      'Pracuję ze sprawdzonymi platformami księgowymi i mogę dostosować się do oprogramowania, które najlepiej pasuje do potrzeb Twojej firmy. Podczas konsultacji wspólnie ustalimy najlepsze rozwiązanie.',
  },
  {
    question: 'Czy zawsze będę pracować bezpośrednio z Tobą?',
    answer:
      'Tak. Jako niezależna księgowa jestem Twoim bezpośrednim kontaktem od pierwszej rozmowy przez cały okres współpracy. Zawsze będziesz wiedzieć, kto zajmuje się Twoją firmą.',
  },
  {
    question: 'Co się dzieje, gdy jesteś niedostępna lub na urlopie?',
    answer:
      'Każdy klient jest informowany z wyprzedzeniem o planowanym urlopie, a ważne terminy są starannie zaplanowane, aby Twoja księgowość działała bez przerw. Twoja firma zawsze pozostaje w pełni obsłużona.',
  },
];

const items = faqs && faqs.length > 0 ? faqs : defaultFaqs;
const buttonHref = button ? resolveLinkHref(button) : '#';
const showButton = button?.label && buttonHref !== '#';
---

<Section class="bg-cream">
  <Container>
    <div class="flex w-full flex-col gap-16 lg:flex-row lg:items-stretch lg:gap-[127px] lg:justify-between">
      <div data-reveal style="--reveal-delay: 0ms" class="flex w-full flex-col justify-between gap-8 lg:w-[541px]">
        <div class="flex flex-col gap-4">
          {tagline && <SectionLabel>{tagline}</SectionLabel>}
          <Heading as="h2">{heading}</Heading>
        </div>
        <div class="flex flex-col gap-6 border-t border-[rgba(3,15,34,0.08)] pt-8">
          {description && <p class="text-body text-navy/80">{description}</p>}
          {showButton && (
            <Button variant="accent" href={buttonHref} class="self-start">
              {button.label}
            </Button>
          )}
        </div>
      </div>

      <div class="w-full lg:max-w-2xl">
        {items.map((faq, index) => (
          <AccordionItem question={faq.question} open={false} revealDelay={150 + index * 100}>
            {faq.answer}
          </AccordionItem>
        ))}
      </div>
    </div>
  </Container>
</Section>
