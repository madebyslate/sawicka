---
import PageHero from '../PageHero/PageHero.astro';
import Section from '../../ui/Section/Section.astro';
import Container from '../../ui/Container/Container.astro';
import { lexicalToHtml } from '../../../lib/payload/richText';

interface Props {
  tagline?: string | null;
  heading: string;
  content?: unknown;
}

const { tagline, heading, content } = Astro.props;

const contentHtml = lexicalToHtml(content as Parameters<typeof lexicalToHtml>[0]);
---

<PageHero tagline={tagline} heading={heading} />

<Section class="bg-cream">
  <Container>
    <div class="mx-auto max-w-3xl">{contentHtml && <div class="post-content" set:html={contentHtml} />}</div>
  </Container>
</Section>
