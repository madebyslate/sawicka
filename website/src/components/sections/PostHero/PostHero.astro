---
import Container from '../../ui/Container/Container.astro';
import Heading from '../../ui/Heading/Heading.astro';
import GridLines from '../../ui/GridLines/GridLines.astro';
import { noiseBackgroundImage } from '../../../lib/noiseBackground';

interface Props {
  heading: string;
  category?: string | null;
  date?: string | null;
  readTime?: string | null;
}

const { heading, category, date, readTime } = Astro.props;
---

<section
  class="relative isolate flex h-121.25 items-center overflow-hidden"
  style="background: linear-gradient(180deg, #030F22 0%, #14243D 100%);"
>
  <div
    class="pointer-events-none absolute z-[-15] rounded-full mix-blend-lighten"
    style="left: 15%; top: 55%; width: 70%; height: 100%; background: #8D96A5; opacity: 0.4; filter: blur(140px);"
  >
  </div>

  <div
    class="pointer-events-none absolute inset-0 -z-15 opacity-[0.32] mix-blend-soft-light"
    style={`background-image: ${noiseBackgroundImage}; background-repeat: repeat;`}
  >
  </div>

  <GridLines gap={180} offset={60} />

  <Container class="relative flex flex-col items-center gap-6 pt-25.75 text-center">
    <Heading
      as="h1"
      data-reveal
      style="--reveal-delay: 0ms; --reveal-duration: 1.1s; --reveal-distance: 2.5rem"
      class="max-w-4xl text-white"
    >
      {heading}
    </Heading>

    {(date || readTime || category) && (
      <div data-reveal style="--reveal-delay: 150ms" class="flex flex-wrap items-center justify-center gap-4">
        {(date || readTime) && (
          <div class="flex items-center gap-3 text-white/80">
            {date && (
              <span class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 18 18" aria-hidden="true">
                  <path
                    stroke="#fff"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16.5 9c0 4.14-3.36 7.5-7.5 7.5S1.5 13.14 1.5 9 4.86 1.5 9 1.5s7.5 3.36 7.5 7.5"
                  />
                  <path
                    stroke="#fff"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M11.783 11.385 9.458 9.998c-.405-.24-.735-.818-.735-1.29V5.633"
                  />
                </svg>
                <span class="text-body">{date}</span>
              </span>
            )}
            {date && readTime && <span aria-hidden="true">&middot;</span>}
            {readTime && (
              <span class="flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 18 18" aria-hidden="true">
                  <path
                    stroke="#fff"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16.5 12.555V3.503c0-.9-.735-1.568-1.627-1.493h-.045c-1.575.135-3.968.938-5.303 1.778l-.127.082a.83.83 0 0 1-.796 0l-.187-.112C7.08 2.925 4.695 2.13 3.12 2.003c-.893-.075-1.62.6-1.62 1.492v9.06c0 .72.585 1.395 1.305 1.485l.217.03c1.628.218 4.14 1.043 5.58 1.83l.03.015a.81.81 0 0 0 .72 0c1.44-.795 3.96-1.627 5.595-1.845l.248-.03c.72-.09 1.305-.765 1.305-1.485M9 4.117v11.25M5.813 6.367H4.125M6.375 8.617h-2.25"
                  />
                </svg>
                <span class="text-body">{readTime}</span>
              </span>
            )}
          </div>
        )}
        {category && (
          <span class="rounded-pill border border-white/60 px-3 py-1 text-tagline text-white/80">
            {category}
          </span>
        )}
      </div>
    )}
  </Container>
</section>
