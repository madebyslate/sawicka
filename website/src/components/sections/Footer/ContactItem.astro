---
import FooterLabel from './FooterLabel.astro';

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={['flex flex-col items-start gap-2', className]}>
  <FooterLabel>{label}</FooterLabel>
  <p class="text-2xl leading-[1.4] tracking-[-0.04em] text-white">
    <slot />
  </p>
</div>
