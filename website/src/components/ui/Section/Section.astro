---
interface Props {
  as?: 'section' | 'div' | 'article' | 'footer';
  id?: string;
  ariaLabelledby?: string;
  class?: string;
}

const { as: Tag = 'section', id, ariaLabelledby, class: className } = Astro.props;
---

<Tag id={id} aria-labelledby={ariaLabelledby} class:list={['py-16 sm:py-20 lg:py-24', className]}>
  <slot />
</Tag>
