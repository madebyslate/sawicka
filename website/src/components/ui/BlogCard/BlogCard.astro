---
import type { Post } from '@payload-types';
import Heading from '../Heading/Heading.astro';
import Button from '../Button/Button.astro';
import { resolveMediaUrl } from '../../../lib/payload/media';
import { getPostHref } from '../../../lib/payload/posts';

interface Props {
  post: Post;
  class?: string;
  revealDelay?: number;
  readArticleLabel?: string | null;
  [dataAttribute: `data-${string}`]: unknown;
}

const { post, class: className, revealDelay, readArticleLabel, ...rest } = Astro.props;

const categoryName = typeof post.category === 'object' ? post.category?.name : undefined;
const postHref = getPostHref(post);
const imageUrl = resolveMediaUrl(post.featuredImage);
const imageAlt = typeof post.featuredImage === 'object' ? post.featuredImage.alt : '';
const imageWidth = typeof post.featuredImage === 'object' ? (post.featuredImage.width ?? undefined) : undefined;
const imageHeight = typeof post.featuredImage === 'object' ? (post.featuredImage.height ?? undefined) : undefined;
const formattedDate = post.publishedDate
  ? new Date(post.publishedDate).toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---

<article
  {...rest}
  data-reveal={revealDelay !== undefined ? true : undefined}
  style={
    revealDelay !== undefined
      ? `--reveal-delay: ${revealDelay}ms; --reveal-duration: 0.9s; --reveal-distance: 2rem`
      : undefined
  }
  class:list={[
    'group relative flex w-full flex-col gap-6 rounded-card border-2 border-white bg-card pt-3 px-3 pb-8',
    className,
  ]}
>
  {
    imageUrl && (
      <div class="h-75 w-full overflow-hidden rounded-icon">
        <img
          src={imageUrl}
          alt={imageAlt}
          width={imageWidth}
          height={imageHeight}
          loading="lazy"
          class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover:scale-105"
        />
      </div>
    )
  }
  <div class="flex flex-col gap-6 px-3">
    <div class="flex flex-col">
      <div class="flex flex-col gap-2">
        {categoryName && <p class="text-tagline font-medium text-bronze">{categoryName}</p>}
        <Heading as="h3" class="font-normal" style="line-height: 130%;">
          <a href={postHref} class="after:absolute after:inset-0 after:content-['']">
            {post.title}
          </a>
        </Heading>
      </div>

      <div class="mt-4 flex items-center text-navy">
        {formattedDate && (
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 18 18" aria-hidden="true">
              <path
                stroke="#030f22"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M16.5 9c0 4.14-3.36 7.5-7.5 7.5S1.5 13.14 1.5 9 4.86 1.5 9 1.5s7.5 3.36 7.5 7.5"
              />
              <path
                stroke="#030f22"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M11.783 11.385 9.458 9.998c-.405-.24-.735-.818-.735-1.29V5.633"
              />
            </svg>
            <span class="text-body" style="line-height: normal;">{formattedDate}</span>
          </span>
        )}
        {formattedDate && post.readTime && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="4"
            height="4"
            fill="none"
            viewBox="0 0 4 4"
            class="mx-3"
            aria-hidden="true"
          >
            <circle cx="2" cy="2" r="2" fill="#030f22" opacity=".16" />
          </svg>
        )}
        {post.readTime && (
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 18 18" aria-hidden="true">
              <path
                stroke="#030f22"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M16.5 12.555V3.503c0-.9-.735-1.568-1.627-1.493h-.045c-1.575.135-3.968.938-5.303 1.778l-.127.082a.83.83 0 0 1-.796 0l-.187-.112C7.08 2.925 4.695 2.13 3.12 2.003c-.893-.075-1.62.6-1.62 1.492v9.06c0 .72.585 1.395 1.305 1.485l.217.03c1.628.218 4.14 1.043 5.58 1.83l.03.015a.81.81 0 0 0 .72 0c1.44-.795 3.96-1.627 5.595-1.845l.248-.03c.72-.09 1.305-.765 1.305-1.485M9 4.117v11.25M5.813 6.367H4.125M6.375 8.617h-2.25"
              />
            </svg>
            <span class="text-body" style="line-height: normal;">{post.readTime}</span>
          </span>
        )}
      </div>

      <hr class="mt-6 border-t border-navy/8" />

      {post.excerpt && <p class="mt-6 line-clamp-2 text-body text-navy/80">{post.excerpt}</p>}
    </div>
    <Button variant="accent" href={postHref} class="relative z-10 self-start">
      {readArticleLabel || 'Czytaj artykuł'}
    </Button>
  </div>
</article>
