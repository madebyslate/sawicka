---
interface Props {
  src: string;
  alt?: string;
  size?: number;
  class?: string;
}

const { src, alt = '', size = 24, class: className } = Astro.props;
---

<span
  class:list={['inline-block shrink-0 overflow-clip', className]}
  style={{ width: `${size}px`, height: `${size}px` }}
>
  <img src={src} alt={alt} width={size} height={size} loading="lazy" class="block size-full" />
</span>
