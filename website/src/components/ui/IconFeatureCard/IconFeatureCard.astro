---
import Icon from '../Icon/Icon.astro';
import Heading from '../Heading/Heading.astro';

interface Props {
  icon: string;
  title: string;
  class?: string;
}

const { icon, title, class: className } = Astro.props;
---

<div
  class:list={[
    'flex h-full w-full flex-col justify-between items-start gap-[10px] rounded-[16px] border-2 border-white bg-[#ECE2D0] px-6 pt-6 pb-8',
    className,
  ]}
>
  <span class="grid size-[62px] shrink-0 place-items-center rounded-icon bg-bronze">
    <Icon src={icon} alt="" size={32} />
  </span>
  <div class="flex flex-col gap-[10px]">
    <Heading
      as="h3"
      class="text-[#030F22] font-serif text-[28px] leading-[33.6px] tracking-[-1.12px] font-normal"
    >
      {title}
    </Heading>
    <p class="text-[16px] leading-[160%] text-[#030F22] opacity-80">
      <slot />
    </p>
  </div>
</div>
