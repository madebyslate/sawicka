# One public HTTPS origin for both Astro and Payload.
PUBLIC_SITE_URL=https://sawickagrzyb.pl

# Central PostgreSQL. URL-encode special characters in credentials.
DATABASE_URL=postgresql://app_user:change-me@central-postgres:5432/sawicka
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Optional xCloud redeploy webhook called after content changes in Payload.
DEPLOY_HOOK_URL=

# Only Nginx is published on the host.
APP_PORT=8081

# Existing Docker network shared with the central PostgreSQL service.
POSTGRES_NETWORK=phobos-internal

# Stable Docker volume name; keep it unchanged across redeployments.
PAYLOAD_MEDIA_VOLUME=sawicka-payload-media
