{
  "name": "sawicka-grzyb",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Sawicka Grzyb — Księgowość i Podatki. Monorepo: payload/ (CMS) + website/ (Astro).",
  "scripts": {
    "dev:payload": "cd payload && docker compose up -d",
    "dev:website": "cd website && pnpm dev",
    "build:payload": "cd payload && pnpm build",
    "build:website": "cd website && pnpm build",
    "generate:types": "cd payload && pnpm generate:types",
    "check:website": "cd website && pnpm check",
    "seed": "pnpm --filter payload seed",
    "storybook": "cd website && pnpm storybook"
  }
}
