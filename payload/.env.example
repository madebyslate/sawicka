DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Publiczny adres frontendu (Astro) — zasila przycisk "Przejdź do strony" w adminie
# (Pages/Posts). W dev to zwykle adres serwera `astro dev` (patrz website/CLAUDE.md).
# UWAGA: to NIE to samo co PUBLIC_SITE_URL (ten drugi ustawia serverURL Payloada
# i wpływa na absolutne URL-e mediów — nie wolno ich mylić/nadpisywać wzajemnie).
PUBLIC_FRONTEND_URL=http://localhost:4321

# URL webhooka rebuildu hostingu (np. Vercel/Netlify Deploy Hook).
# Puste = brak automatycznego rebuildu (bezpieczne w dev).
DEPLOY_HOOK_URL=
